models_dev_cache.etag
provider_models_cache.json
ollama_cloud_models_cache.json
.skills_prompt_snapshot.json

# Regenerated from config.yaml
channel_directory.json
channel_aliases.json
context_length_cache.yaml
projects.db

# Logs and sessions
logs/
sessions/
backups/
attachments/
assets/

# Cron runtime state — but KEEP jobs.json
*/cron/ticker_*
*/cron/heartbeat
*/cron/last_success
*/cron/*.lock
*/cron/.fire-*.lock
*/cron/executions.db
*/cron/notepad.db
*/cron/usage_audit.jsonl

